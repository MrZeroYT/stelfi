# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already in .gitignore.

# Deployed contract addresses (Arc Testnet)
NEXT_PUBLIC_FX_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PREDICT_CONTRACT=0x0000000000000000000000000000000000000000

# Arc Testnet RPC (public endpoint — safe to commit)
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network

# Arc chain ID
NEXT_PUBLIC_CHAIN_ID=5042002

# USDC token address on Arc Testnet (official — safe to commit)
NEXT_PUBLIC_ARC_USDC=0x3600000000000000000000000000000000000000
